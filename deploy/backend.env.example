# Template only. Does not provision services or make separate disks shareable.
APP_ENV=production
AUTH_MODE=supabase
AUTO_CREATE_DATABASE_TABLES=false
RECOVER_INTERRUPTED_TASKS_ON_STARTUP=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DATABASE_HOST/DBNAME?sslmode=require
SUPABASE_URL=https://project.example.invalid
SUPABASE_ANON_KEY=REPLACE_WITH_PUBLISHABLE_OR_LEGACY_ANON_KEY
BACKEND_CORS_ORIGINS=https://app.example.invalid
# Reuse the existing master key when migrating existing encrypted data.
# Do not generate a replacement key as part of a deployment or restart.
USER_API_KEY_ENCRYPTION_KEY=REUSE_EXISTING_MASTER_KEY_FROM_SECURE_BACKUP
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=/app/storage/chroma
VIDEO_STORAGE_DIR=/app/storage/videos
AUDIO_STORAGE_DIR=/app/storage/audio
TRANSCRIPT_STORAGE_DIR=/app/storage/transcripts
NOTE_STORAGE_DIR=/app/storage/notes
ASR_PROVIDER=disabled
EMBEDDING_PROVIDER=local_hash
MIN_MEDIA_FREE_SPACE_MB=1024
# Remaining quotas retain code defaults; size the durable storage accordingly.
# Authenticated users supply their own provider keys through personal settings.
