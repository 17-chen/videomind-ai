# Project
APP_NAME=VideoMind AI
APP_ENV=local
DEFAULT_LANGUAGE=zh-CN
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Used by Next.js server components when frontend runs inside Docker.
INTERNAL_API_BASE_URL=http://backend:8000/api/v1

# Backend
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=videomind
POSTGRES_USER=videomind
POSTGRES_PASSWORD=videomind_dev_password
DATABASE_URL=postgresql+psycopg://videomind:videomind_dev_password@postgres:5432/videomind

# ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=videomind_videos

# Embedding
# Phase 5 defaults to local deterministic embeddings to avoid OpenAI dependency.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_DIMENSIONS=384

# AI Provider
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ASR Provider
# DeepSeek does not provide a Whisper-style audio transcription API.
# Keep this disabled to avoid using OpenAI. Videos with subtitles can still be processed.
ASR_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# Video processing
VIDEO_STORAGE_DIR=/app/storage/videos
AUDIO_STORAGE_DIR=/app/storage/audio
TRANSCRIPT_STORAGE_DIR=/app/storage/transcripts
NOTE_STORAGE_DIR=/app/storage/notes
MAX_UPLOAD_MB=1024

# Supported source adapters for Phase 1 planning.
SUPPORTED_VIDEO_SOURCES=douyin,bilibili
