# Project
APP_NAME=VideoMind AI
APP_ENV=local
DEFAULT_LANGUAGE=zh-CN
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Used by Next.js server components when frontend runs inside Docker.
INTERNAL_API_BASE_URL=http://backend:8000/api/v1

# Backend
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Authentication. Keep demo locally; use supabase after configuring the values below.
AUTH_MODE=demo
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=videomind
POSTGRES_USER=videomind
POSTGRES_PASSWORD=videomind_dev_password
DATABASE_URL=postgresql+psycopg://videomind:videomind_dev_password@postgres:5432/videomind
# Local development can create missing tables automatically. Set to false in production and run Alembic migrations.
AUTO_CREATE_DATABASE_TABLES=true

# ChromaDB
# embedded persists in storage/chroma; use http only when running a separate Chroma server.
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=/app/storage/chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=videomind_videos

# Embedding
# Phase 5 defaults to local deterministic embeddings to avoid OpenAI dependency.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_DIMENSIONS=384

# AI Provider
# Required to encrypt user-supplied API keys at rest. Generate once with Fernet.generate_key(), keep it stable, and never commit it.
USER_API_KEY_ENCRYPTION_KEY=
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ASR Provider
# DeepSeek does not provide a Whisper-style audio transcription API.
# Demo fallback stays disabled by default. A logged-in user can supply their own OpenAI transcription key in Settings.
# Videos with subtitles can still be processed without ASR.
ASR_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# Video processing
VIDEO_STORAGE_DIR=/app/storage/videos
AUDIO_STORAGE_DIR=/app/storage/audio
TRANSCRIPT_STORAGE_DIR=/app/storage/transcripts
NOTE_STORAGE_DIR=/app/storage/notes
MAX_UPLOAD_MB=1024
# Optional. Bilibili may require a logged-in Netscape-format cookie file when it returns HTTP 412.
VIDEO_COOKIE_FILE=
# Optional proxy URL used by yt-dlp, for example http://host.docker.internal:7897.
VIDEO_HTTP_PROXY=

# Supported source adapters for Phase 1 planning.
SUPPORTED_VIDEO_SOURCES=douyin,bilibili
